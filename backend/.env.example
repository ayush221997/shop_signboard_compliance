# Copy this file to .env and fill in ONE of the two auth options.
# Never commit .env to git.

# --- Option A: Service account JSON (recommended) ---
# Download a service-account key JSON from Google Cloud Console
# (IAM & Admin → Service Accounts → your SA → Keys → Add Key → JSON)
# then set the full path here:
GOOGLE_APPLICATION_CREDENTIALS="C:\Users\ayusi\Downloads\complai-494418-75a5eda5814c.json"
# --- Option B: API key ---
# Create an API key in Google Cloud Console (APIs & Services → Credentials)
# with the Cloud Vision API enabled, then set it here instead of Option A:
# GOOGLE_API_KEY=AIza...

# Optional: when you add a state/UT ruleset for signboard compliance (COMPLai).
# COMPLIANCE_RULESET_ID=
# Minimum Vision language confidence to treat a text block as that script for threshed ink (0–1).
# OCR_INK_TAG_CONFIDENCE=0.85

# (Legacy) The API no longer passes Vision language hints — OCR is state-agnostic.
# Kept for optional tools; main /api/ocr and suggest-corners use script auto-detect.
# VISION_LANGUAGE_HINTS_EXTRA=
# Set to 1 to adaptive-binarize raster images before DOCUMENT_TEXT_DETECTION (coloured boards).
# For bright / washed images, a CLAHE retone is used instead of a harsh binary.
# VISION_OCR_PREBINARIZE=0
# Disable high-key / glare heuristics (CLAHE, soft HSV, smart prebinarization) to restore legacy behaviour.
# OCR_DISABLE_LIGHT_AWARE=0

# --- Database (PostgreSQL in production; SQLite is used if unset) ---
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/ocr_audit

# Extra browser origins for CORS (comma-separated), e.g. http://my-pc.local:5173
# CORS_EXTRA_ORIGINS=

# Public base URL for stored image links (include scheme, no trailing slash)
# PUBLIC_BASE_URL=http://127.0.0.1:8000
# Local dir for uploads when S3 is not set (default: backend/data/uploads)
# LOCAL_STORAGE_DIR=

# Optional S3 (if S3_BUCKET is set, image bytes are written there; otherwise local disk)
# S3_BUCKET=
# AWS_REGION=us-east-1
# S3_PUBLIC_BASE_URL=https://your-cdn-or-bucket.s3.../

# Nominatim (reverse geocode) user-agent; use a real contact in production
# NOMINATIM_USER_AGENT=OCR-Compliance-App/1.0 (you@example.com)

# Gemini (optional): English translation for non-English text blocks. Same key as AI Studio works.
# Set GEMINI_API_KEY or use GOOGLE_API_KEY from Google AI / Cloud Console, then restart the server.
# GEMINI_API_KEY=
# Model id (older names like gemini-1.5-flash can 404 on the current API; default is 2.0 flash)
# GEMINI_MODEL=gemini-2.0-flash
